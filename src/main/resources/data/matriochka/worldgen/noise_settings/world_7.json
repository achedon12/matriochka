      "label": "PS"
    }
  ],
  "default_block": "matriochka:trench_rock",
  "default_fluid": "minecraft:water",
  "disable_mob_generation": false,
  "legacy_random_source": false,
  "material_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      "minecraft:bedrock_floor",
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": [
            "matriochka:world_7_coral_shelf"
          ]
        },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "add_surface_depth": false,
            "offset": 0,
            "secondary_depth_range": 0,
            "surface_type": "floor"
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": "minecraft:sand"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": [
            "matriochka:world_7_black_trench"
          ]
        },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "add_surface_depth": false,
            "offset": 0,
            "secondary_depth_range": 0,
            "surface_type": "floor"
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": "matriochka:trench_rock"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:above_preliminary_surface"
        },
        "then_run": {
          "type": "minecraft:sequence",
          "sequence": [
            {
              "type": "minecraft:condition",
              "if_true": "minecraft:on_floor",
              "then_run": {
                "type": "minecraft:sequence",
                "sequence": [
                  {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:steep"
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": "matriochka:trench_rock"
                    }
                  },
                  {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:noise_threshold",
                      "noise": "minecraft:surface",
                      "min_threshold": 0.45,
                      "max_threshold": 10.0
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": "matriochka:trench_rock"
                    }
                  },
                  {
                    "type": "minecraft:block",
                    "result_state": "matriochka:abyssal_sand"
                  }
                ]
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": "minecraft:under_floor",
              "then_run": {
                "type": "minecraft:sequence",
                "sequence": [
                  {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:steep"
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": "matriochka:trench_rock"
                    }
                  },
                  {
                    "type": "minecraft:block",
                    "result_state": "matriochka:abyssal_sand"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "noise": {
